    "tailwindcss": "^4.1.4",
    "typewriter-effect": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.0.4",
    "@types/react-dom": "^18.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
